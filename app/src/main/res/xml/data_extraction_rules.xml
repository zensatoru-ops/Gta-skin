<?xml version="1.0" encoding="utf-8"?>
<!-- Tidak ada data yang di-backup atau dipindah; sesuai allowBackup=false. / No data is backed up or transferred; matches allowBackup=false. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
